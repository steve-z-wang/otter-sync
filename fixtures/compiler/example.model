enum Status { active archived @deprecated(reason: "archive with RemoveEntries instead") }
abstract model IdentifiedFields { id UUID }
abstract model EntryFields extends IdentifiedFields {
 title String
 note String?
 at DateTime
 tags String[]
 status Status
}
model Entry extends EntryFields {
 @@id(id)
 @@version(2)
 @@bootstrap
}
mutation CreateEntry { entry Entry.create }
mutation EditEntry { entry Entry.update<title,note,at> @@version(2) }
mutation RemoveEntries { entries Entry.delete[] maybe Entry.update<note>? @deprecated(reason: "use entries") @@version(2) }
