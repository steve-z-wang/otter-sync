      "encoded": "{\"kind\":\"add\",\"record\":{\"identity\":{\"id\":\"t1\"},\"model\":\"Todo\"},\"scope\":\"project:p1\",\"tags\":[\"Journal:1\",\"équipe\"]}",
      "bytes": 115
    }
  ]
}
