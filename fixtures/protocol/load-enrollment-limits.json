{
  "description": "Bounds on the Channel enrollment one Load page declares, after deduplicating repeated Channel/record pairs (a repeated pair unions its tags into the first). A pair's bytes are the UTF-8 length of the canonical JSON of its add intent {channel, kind, record: {identity, model}, tags} with its canonical identity.",
  "pairs": 1000,
  "bytes": 1048576,
  "intents": [
    {
      "name": "an ASCII pair",
      "intent": {
        "kind": "add",
        "channel": "project:p1",
        "record": {
          "model": "Todo",
          "identity": {
            "id": "t1"
          }
        },
        "tags": []
      },
      "encoded": "{\"channel\":\"project:p1\",\"kind\":\"add\",\"record\":{\"identity\":{\"id\":\"t1\"},\"model\":\"Todo\"},\"tags\":[]}",
      "bytes": 96
    },
    {
      "name": "multibyte UTF-8 counts bytes, not characters",
      "intent": {
        "kind": "add",
        "channel": "équipe",
        "record": {
          "model": "Todo",
          "identity": {
            "id": "日本"
          }
        },
        "tags": []
      },
      "encoded": "{\"channel\":\"équipe\",\"kind\":\"add\",\"record\":{\"identity\":{\"id\":\"日本\"},\"model\":\"Todo\"},\"tags\":[]}",
      "bytes": 97
    },
    {
      "name": "escapes and an astral character",
      "intent": {
        "kind": "add",
        "channel": "a\"b\n😀",
        "record": {
          "model": "Todo",
          "identity": {
            "id": "t\\1"
          }
        },
        "tags": []
      },
      "encoded": "{\"channel\":\"a\\\"b\\n😀\",\"kind\":\"add\",\"record\":{\"identity\":{\"id\":\"t\\\\1\"},\"model\":\"Todo\"},\"tags\":[]}",
      "bytes": 98
    },
    {
      "name": "identity members in canonical order",
      "intent": {
        "kind": "add",
        "channel": "org",
        "record": {
          "model": "Member",
          "identity": {
            "userId": "u1",
            "orgId": "o1"
          }
        },
        "tags": []
      },
      "encoded": "{\"channel\":\"org\",\"kind\":\"add\",\"record\":{\"identity\":{\"orgId\":\"o1\",\"userId\":\"u1\"},\"model\":\"Member\"},\"tags\":[]}",
      "bytes": 108
    },
    {
      "name": "tags count as spelled, in declaration order",
      "intent": {
        "kind": "add",
        "channel": "project:p1",
        "record": {
          "model": "Todo",
          "identity": {
            "id": "t1"
          }
        },
        "tags": [
          "Journal:1",
          "équipe"
        ]
      },
      "encoded": "{\"channel\":\"project:p1\",\"kind\":\"add\",\"record\":{\"identity\":{\"id\":\"t1\"},\"model\":\"Todo\"},\"tags\":[\"Journal:1\",\"équipe\"]}",
      "bytes": 117
    }
  ]
}
