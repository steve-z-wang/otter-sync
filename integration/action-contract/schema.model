enum Status { open closed archived }
model Todo {
 id String
 title String
 state Status
 note String?
 @@id(id)
 @@version(2)
}
model Project {
 tenantId String
 id String
 title String
 @@id(tenantId, id)
}
@version(2)
mutation AddTodo(todo Todo.create, patch Todo.update<title>?, gone Todo.delete[], status Status?, tags String[]) {
 relatedTodo Todo?
 matches Todo[]
 count Int
 state Status?
}
mutation Link(project Project.create) { relatedProject Project? }
mutation Ping()
mutation RemoveTodo(todo Todo.delete)
mutation Search(query String?)
mutation DeleteTodo(todo Todo.delete)
mutation SendEmail(to String, subject String, body String)
// Model operands are mutation targets, never results (#140): Edit has no
// result, and EditAndRead's todo output is independent of its todo input.
mutation Edit(todo Todo.update)
mutation EditAndRead(todo Todo.update) {
 todo Todo
}
// A list of update operands encodes each element as an object (#182).
mutation EditMany(todos Todo.update<title>[])
// GetTodos v1 is retained as a Mutation; v2 is the same read as a Query.
@version(2) query GetTodos() { todos Todo[] }
@version(2) mutation StateList() { states Status[] }
mutation OpenTodo(store String?) {
 mainTodo Todo
 suggestions Todo[]
 related Todo?
 count Int
}
query FindTodos(text String, cursor String?) {
 todos Todo[]
 nextCursor String?
}
// Creation defaults (#27): only client create inputs may omit these fields.
model Note {
 id String @default(uuid())
 body String @default("")
 pinned Boolean @default(false)
 at DateTime @default(now())
 tag String? @default("t")
 memo String?
 @@id(id)
}
mutation AddNotes(note Note.create, maybe Note.create?, many Note.create[]) { saved Note }
// A named Query fills Model lists page by page (#173); its handler answers identities.
query ProjectTodos(projectId String, status Status?, tags String[]) {
 todos Todo[]
 projects Project[]
}
// A named Query without inputs, and one whose business inputs take the option names:
// Dart then names the call-site controls callOnce and callRefresh.
query RecentTodos() { todos Todo[] }
query FlaggedTodos(once Boolean, refresh String) { todos Todo[] }
// A business input named client: the Dart route must still reach the field.
query ClientTodos(client String) { todos Todo[] }
