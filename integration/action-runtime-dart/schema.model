enum Mood { calm loud }
model Note {
 id String
 at DateTime
 mood Mood
 label String?
 @@id(id)
}
mutation Echo(at DateTime, moods Mood[], maybe DateTime?) { result DateTime moods Mood[] maybe DateTime? }
mutation Touch(note Note.create, changed Note.update<at>?) { stamp DateTime }
mutation Ping()
query Now(at DateTime) { at DateTime }
// A multi-output Query (#173): two Model lists, typed DateTime and enum inputs.
query NotesSince(since DateTime?, moods Mood[]) { notes Note[] pinned Note[] }
