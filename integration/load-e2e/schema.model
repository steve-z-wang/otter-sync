// Bounded Bootstrap and named history reads over real HTTP, PostgreSQL and SQLite.
model Item {
 id String
 project String
 title String
 @@id(id)
 @@bootstrap
}
model Tag {
 id String
 label String
 @@id(id)
}
// Device-only bookkeeping created explicitly in local Mutation callbacks.
model Seen {
 id String
 hits Int
 @@id(id)
}
// Item writes join the Item's project Scope, so later changes reach live
// subscribers.
@version(2) mutation AddItem(item Item.create) { item Item }
@version(2) mutation RenameItem(item Item.update<title>) { item Item }
mutation Ping(note String)
query ProjectItems(project String) { items Item[] tags Tag[] }
query Catalog(shelf String?) { items Item[] }
