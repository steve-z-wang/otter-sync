{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["generated/*.ts", "*.mts"]
}
