{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "axton",
      "extra-files": [
        { "type": "json", "path": "packages/server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "packages/client-js/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/client-js/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/client-js/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "packages/postgres/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "packages/dart/pubspec.yaml" },
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "bindings/node/Cargo.toml", "jsonpath": "$.package.version" }
      ]
    }
  }
}
