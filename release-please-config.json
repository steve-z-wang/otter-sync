{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "prerelease": true,
  "packages": {
    ".": {
      "package-name": "axton",
      "extra-files": [
        { "type": "json", "path": "packages/native/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package.json", "jsonpath": "$.dependencies['@axtonjs/native']" },
        { "type": "json", "path": "packages/client-js/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/client-js/package.json", "jsonpath": "$.dependencies['@axtonjs/native']" },
        { "type": "json", "path": "packages/postgres/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/postgres/package.json", "jsonpath": "$.dependencies['@axtonjs/server']" },
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/native/npm/darwin-arm64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/native/npm/linux-x64-gnu/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/npm/darwin-arm64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/npm/linux-x64-gnu/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/native'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/server'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/server'].dependencies['@axtonjs/native']" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/client-js'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/client-js'].dependencies['@axtonjs/native']" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/postgres'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/postgres'].dependencies['@axtonjs/server']" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/cli'].version" },
        { "type": "generic", "path": "packages/dart/pubspec.yaml" },
        { "type": "generic", "path": "packages/dart/lib/src/native_manifest.dart" },
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "bindings/node/Cargo.toml", "jsonpath": "$.package.version" }
      ]
    }
  }
}
