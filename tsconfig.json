{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/frontend/client-js/**/*.mts",
    "packages/backend/server/**/*.mts",
    "packages/backend/postgres/*.mts",
    "packages/backend/postgres/src/*.mts",
    "integration/e2e/fixtures/round-trip/*.mts",
    "examples/todo/*.mts"
  ]
}
